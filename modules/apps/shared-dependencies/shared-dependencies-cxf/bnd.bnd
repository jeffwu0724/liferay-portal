Bundle-Name: Liferay Shared Dependencies CXF
Bundle-SymbolicName: com.liferay.shared.dependencies.cxf
Bundle-Version: 1.0.0
Import-Package:\
	!com.sun.msv.*,\
	\
	!jakarta.xml.bind.*,\
	\
	!javax.cache.*,\
	\
	!javax.ws.rs.client.*,\
	!javax.ws.rs.sse.*,\
	\
	!javax.wsdl.extensions.*,\
	\
	!net.sf.cglib.proxy.*,\
	\
	!org.apache.abdera.*,\
	!org.apache.aries.blueprint.*,\
	!org.apache.axiom.om.*,\
	!org.apache.cxf.aegis.*,\
	!org.apache.cxf.annotations.*,\
	!org.apache.cxf.binding.*,\
	!org.apache.cxf.binding.soap.model.*,\
	!org.apache.cxf.rt.security.*,\
	!org.apache.xml.resolver.*,\
	\
	!org.osgi.service.blueprint.*,\
	\
	!org.springframework.osgi.io.*,\
	!org.springframework.osgi.util.*,\
	!org.springframework.web.servlet.*,\
	\
	*
-exportcontents: org.apache.cxf.*
-fixupmessages: Classes found in the wrong directory: ...;is:=ignore