Bundle-Name: Liferay Dynamic Data Lists Test
Bundle-SymbolicName: com.liferay.dynamic.data.lists.test
Bundle-Version: 1.0.0
Import-Package:\
	!com.github.luben.*,\
	\
	!com.graphbuilder.*,\
	\
	!com.microsoft.schemas.office.*,\
	!com.microsoft.schemas.office.x2006.encryption,\
	!com.microsoft.schemas.office.x2006.keyEncryptor.certificate,\
	!com.microsoft.schemas.office.x2006.keyEncryptor.password,\
	\
	!com.sun.*,\
	\
	!com.zaxxer.sparsebits.*,\
	\
	!de.rototor.pdfbox.graphics2d,\
	\
	!net.sf.*,\
	\
	!org.apache.batik.*,\
	!org.apache.commons.math3.*,\
	!org.apache.commons.math3.util.*,\
	!org.apache.jcp.*,\
	!org.apache.tools.ant.*,\
	\
	!org.bouncycastle.*,\
	\
	!org.brotli.*,\
	\
	!org.etsi.*,\
	\
	!org.openxmlformats.*,\
	\
	!org.tukaani.*,\
	\
	!org.w3c.dom.svg,\
	\
	*
-fixupmessages: "^Classes found in the wrong directory: \\\\{META-INF/versions/9/";is:=warning
-includeresource:\
	commons-collections4-[0-9.]*.jar;lib:=true,\
	commons-compress-[0-9.]*.jar;lib:=true,\
	commons-math3-[0-9.]*.jar;lib:=true,\
	poi-[0-9.]*.jar;lib:=true,\
	poi-ooxml-[0-9.]*.jar;lib:=true,\
	poi-ooxml-lite-[0-9.]*.jar;lib:=true,\
	xmlbeans-[0-9.]*.jar;lib:=true