Bundle-Name: Liferay Document Library Opener Google Drive Web
Bundle-SymbolicName: com.liferay.document.library.opener.google.drive.web
Bundle-Version: 3.0.25
Import-Package:\
	!com.google.api.client.json.gson,\
	!com.google.common.util.concurrent.*,\
	\
	!javax.jdo.*,\
	\
	!org.apache.http.*,\
	\
	!org.checkerframework.*,\
	\
	*
Web-ContextPath: /document-library-opener-google-drive-web
-fixupmessages: "^Classes found in the wrong directory: \\\\{META-INF/versions/9/";is:=warning